{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mspaintify",
	"main": "src/worker.py",
	"compatibility_date": "2026-05-13",
	"compatibility_flags": [
		"python_workers",
		"python_workflows",
		"disable_python_external_sdk"
	],
	"assets": {
		"directory": "./assets/",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "mspaint-photos"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CONFIG",
			"id": "b9eaed9dd0034933baeef02b17872923"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"workflows": [
		{
			"name": "mspaint-workflow",
			"binding": "MSPAINT_WORKFLOW",
			"class_name": "MspaintWorkflow"
		}
	],
	"observability": {
		"enabled": true
	}
}
